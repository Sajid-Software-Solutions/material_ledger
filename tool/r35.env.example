# Copy this file to .r35.env (or a named .r35.<environment>.env file) and
# replace every value. It is intentionally ignored by Git.
#
# R35_ENVIRONMENT is an operator declaration, not an application feature flag.
# Valid values: local, staging, production. CI sets ci itself.
R35_ENVIRONMENT=local
SUPABASE_URL=https://replace-with-your-explicit-project.supabase.co
SUPABASE_ANON_KEY=replace-with-that-project-publishable-key
# Public VAPID key from Firebase Console → Project settings → Cloud Messaging
# → Web Push certificates. Required for production browser builds.
FIREBASE_WEB_VAPID_KEY=
# R39 Accounts is separately controlled. Keep false unless the protected
# backend release gate has passed and the release owner authorizes enablement.
# Project setup redesign: enable only for its review/acceptance lane.
YORKS_V1_PROJECT_SETUP=false
YORKS_V1_ACCOUNTS=false
# Company Material Requests are separately controlled. Keep false unless the
# protected policy configuration, RPCs and focused UI release gate have passed.
YORKS_V1_COMPANY_MATERIAL_REQUESTS=false
# The role-based Overview (one home screen per exact role). Keep false until
# its UI acceptance; the retained R35 overview stays in place while off.
YORKS_V1_ROLE_OVERVIEW_V2=false
# Workforce is separately controlled. Keep false unless the protected backend,
# UI and release gates have passed and the release owner authorizes enablement.
YORKS_V1_WORKFORCE=false
# Worker Records (company, licence, passport, salary and photo in User
# Management). Keep false until supabase/release/worker_records_bundle.sql is
# applied to the target database and the release owner authorizes enablement.
YORKS_V1_WORKER_RECORDS=false
# Operational Analytics is retired (PRODUCT_DECISIONS.md section 31); this
# value is ignored.
YORKS_V1_ANALYTICS=false
# External PostHog product/UX telemetry is a separate opt-in from Yorks'
# operational Analytics feature above. Use a distinct project for staging when
# available. The real project token belongs only in the ignored operator env or
# deployment environment, never in this committed example file.
POSTHOG_ENABLED=false
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_ENV=local
POSTHOG_DEBUG=false

# Unified saved calculator workspace; enable after its backend migration.
YORKS_V1_CALCULATOR_WORKSPACE=false
